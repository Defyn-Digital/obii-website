---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OBII marketing site" description="Choose a homepage version to preview.">
	<main class="picker">
		<h1>OBII homepage</h1>
		<p class="lead">Preview the two marketing homepage variants.</p>
		<div class="cards">
			<a class="card" href="/version1">
				<span class="label">Version 1</span>
			</a>
			<a class="card" href="/version2">
				<span class="label">Version 2</span>
			</a>
		</div>
	</main>
</Layout>

<style>
	.picker {
		min-height: 100vh;
		display: grid;
		place-content: center;
		gap: 1.5rem;
		padding: 2rem;
		text-align: center;
	}

	h1 {
		margin: 0;
		font-family: 'Manrope', system-ui, sans-serif;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		color: var(--ink);
	}

	.lead {
		margin: 0;
		color: var(--muted);
		font-size: 1.05rem;
	}

	.cards {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		justify-content: center;
		margin-top: 0.5rem;
	}

	.card {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 11rem;
		min-height: 7rem;
		padding: 1.5rem 2rem;
		border-radius: 1rem;
		border: 1px solid rgba(17, 16, 93, 0.12);
		background: #fff;
		box-shadow: 0 12px 40px rgba(17, 23, 61, 0.08);
		text-decoration: none;
		color: var(--navy);
		transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
	}

	.card:hover {
		border-color: var(--purple);
		box-shadow: 0 16px 48px rgba(113, 87, 255, 0.18);
		transform: translateY(-2px);
	}

	.label {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-weight: 600;
		font-size: 1.125rem;
	}
</style>